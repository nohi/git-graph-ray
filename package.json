{
  "name": "git-graph-ray",
  "displayName": "Git Graph Ray",
  "version": "0.8.1",
  "publisher": "nohi",
  "description": "%description%",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nohi/git-graph-ray.git"
  },
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "git",
    "graph",
    "log",
    "worktree"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:git-graph-ray.graph"
  ],
  "l10n": "./l10n",
  "main": "./dist/host/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "icon": "resources/icon.png",
  "contributes": {
    "commands": [
      {
        "command": "git-graph-ray.view",
        "title": "%command.view%",
        "category": "Git Graph Ray",
        "icon": "resources/icon.png"
      },
      {
        "command": "git-graph-ray.contributors",
        "title": "%command.contributors%",
        "category": "Git Graph Ray"
      },
      {
        "command": "git-graph-ray.addGitRepository",
        "title": "%command.addGitRepository%",
        "category": "Git Graph Ray"
      },
      {
        "command": "git-graph-ray.clearAvatarCache",
        "title": "%command.clearAvatarCache%",
        "category": "Git Graph Ray"
      },
      {
        "command": "git-graph-ray.fetch",
        "title": "%command.fetch%",
        "category": "Git Graph Ray"
      },
      {
        "command": "git-graph-ray.removeGitRepository",
        "title": "%command.removeGitRepository%",
        "category": "Git Graph Ray"
      },
      {
        "command": "git-graph-ray.version",
        "title": "%command.version%",
        "category": "Git Graph Ray"
      },
      {
        "command": "git-graph-ray.openFile",
        "title": "%command.openFile%",
        "category": "Git Graph Ray",
        "icon": "$(go-to-file)",
        "enablement": "isInDiffEditor && resourceScheme == git-graph-ray-file"
      },
      {
        "command": "git-graph-ray.graph.refresh",
        "title": "%command.graph.refresh%",
        "category": "Git Graph Ray"
      },
      {
        "command": "git-graph-ray.graph.scrollToStash",
        "title": "%command.graph.scrollToStash%",
        "category": "Git Graph Ray"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "git-graph-ray.openFile",
          "when": "isInDiffEditor && resourceScheme == git-graph-ray-file"
        },
        {
          "command": "git-graph-ray.graph.refresh",
          "when": "false"
        },
        {
          "command": "git-graph-ray.graph.scrollToStash",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "git-graph-ray.openFile",
          "group": "navigation",
          "when": "isInDiffEditor && resourceScheme == git-graph-ray-file"
        }
      ],
      "scm/title": [
        {
          "when": "scmProvider == git && config.git-graph-ray.startup.scmButton == 'bar'",
          "command": "git-graph-ray.view",
          "group": "navigation"
        },
        {
          "when": "scmProvider == git && config.git-graph-ray.startup.scmButton == 'menu'",
          "command": "git-graph-ray.view",
          "group": "inline"
        }
      ]
    },
    "keybindings": [
      {
        "command": "git-graph-ray.graph.refresh",
        "key": "ctrl+r",
        "mac": "cmd+r",
        "when": "activeWebviewPanelId == 'git-graph-ray.graph' && config.git-graph-ray.keys.refresh == 'mod+r'"
      },
      {
        "command": "git-graph-ray.graph.scrollToStash",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeWebviewPanelId == 'git-graph-ray.graph' && config.git-graph-ray.keys.stash == 'mod+s'"
      },
      {
        "command": "git-graph-ray.graph.scrollToStash",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "activeWebviewPanelId == 'git-graph-ray.graph' && config.git-graph-ray.keys.stash == 'mod+s'",
        "args": {
          "previous": true
        }
      }
    ],
    "resourceLabelFormatters": [
      {
        "scheme": "git-graph-ray-file",
        "formatting": {
          "label": "${path}",
          "separator": "/",
          "workspaceSuffix": "",
          "stripPathStartingSeparator": true
        }
      }
    ],
    "configuration": {
      "title": "Git Graph Ray",
      "properties": {
        "git-graph-ray.actions": {
          "type": "object",
          "additionalProperties": false,
          "markdownDescription": "%config.actions.markdownDescription%",
          "default": {
            "tagAnnotated": true,
            "tagPush": false,
            "stashKeepIndex": false,
            "popKeepIndex": false,
            "cherryNoCommit": false,
            "cherryRecordOrigin": false,
            "branchCheckout": false,
            "branchForceDelete": false,
            "fetchIntoForce": false,
            "nameSpaces": "keep",
            "mergeNoCommit": false,
            "mergeNoFastForward": true,
            "mergeSquash": false,
            "mergeSquashMessage": "subject",
            "pullNoFastForward": false,
            "pullRebase": false,
            "pullSquash": false,
            "pullSquashMessage": "subject",
            "rebaseIgnoreDate": false,
            "rebaseInteractive": false,
            "resetMode": "mixed",
            "resetUncommitted": "mixed",
            "stashUntracked": true
          },
          "properties": {
            "tagAnnotated": {
              "type": "boolean",
              "default": true,
              "description": "%config.actions.tagAnnotated.description%"
            },
            "tagPush": {
              "type": "boolean",
              "default": false,
              "description": "%config.actions.tagPush.description%"
            },
            "stashKeepIndex": {
              "type": "boolean",
              "default": false,
              "description": "%config.actions.stashKeepIndex.description%"
            },
            "popKeepIndex": {
              "type": "boolean",
              "default": false,
              "description": "%config.actions.popKeepIndex.description%"
            },
            "cherryNoCommit": {
              "type": "boolean",
              "default": false,
              "description": "%config.actions.cherryNoCommit.description%"
            },
            "cherryRecordOrigin": {
              "type": "boolean",
              "default": false,
              "description": "%config.actions.cherryRecordOrigin.description%"
            },
            "branchCheckout": {
              "type": "boolean",
              "default": false,
              "description": "%config.actions.branchCheckout.description%"
            },
            "branchForceDelete": {
              "type": "boolean",
              "default": false,
              "description": "%config.actions.branchForceDelete.description%"
            },
            "fetchIntoForce": {
              "type": "boolean",
              "default": false,
              "description": "%config.actions.fetchIntoForce.description%"
            },
            "nameSpaces": {
              "type": "string",
              "enum": [
                "keep",
                "hyphen",
                "underscore"
              ],
              "default": "keep",
              "description": "%config.actions.nameSpaces.description%"
            },
            "mergeNoCommit": {
              "type": "boolean",
              "default": false,
              "description": "%config.actions.mergeNoCommit.description%"
            },
            "mergeNoFastForward": {
              "type": "boolean",
              "default": true,
              "description": "%config.actions.mergeNoFastForward.description%"
            },
            "mergeSquash": {
              "type": "boolean",
              "default": false,
              "description": "%config.actions.mergeSquash.description%"
            },
            "mergeSquashMessage": {
              "type": "string",
              "enum": [
                "subject",
                "file"
              ],
              "default": "subject",
              "description": "%config.actions.mergeSquashMessage.description%"
            },
            "pullNoFastForward": {
              "type": "boolean",
              "default": false,
              "description": "%config.actions.pullNoFastForward.description%"
            },
            "pullRebase": {
              "type": "boolean",
              "default": false,
              "description": "%config.actions.pullRebase.description%"
            },
            "pullSquash": {
              "type": "boolean",
              "default": false,
              "description": "%config.actions.pullSquash.description%"
            },
            "pullSquashMessage": {
              "type": "string",
              "enum": [
                "subject",
                "file"
              ],
              "default": "subject",
              "description": "%config.actions.pullSquashMessage.description%"
            },
            "rebaseIgnoreDate": {
              "type": "boolean",
              "default": false,
              "description": "%config.actions.rebaseIgnoreDate.description%"
            },
            "rebaseInteractive": {
              "type": "boolean",
              "default": false,
              "description": "%config.actions.rebaseInteractive.description%"
            },
            "resetMode": {
              "type": "string",
              "enum": [
                "soft",
                "mixed",
                "hard"
              ],
              "default": "mixed",
              "description": "%config.actions.resetMode.description%"
            },
            "resetUncommitted": {
              "type": "string",
              "enum": [
                "mixed",
                "hard"
              ],
              "default": "mixed",
              "description": "%config.actions.resetUncommitted.description%"
            },
            "stashUntracked": {
              "type": "boolean",
              "default": true,
              "description": "%config.actions.stashUntracked.description%"
            }
          }
        },
        "git-graph-ray.branches.globs": {
          "type": "array",
          "description": "%config.branches.globs.description%",
          "items": {
            "type": "object",
            "required": [
              "name",
              "pattern"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "pattern": {
                "type": "string"
              }
            }
          },
          "default": []
        },
        "git-graph-ray.columns": {
          "type": "object",
          "description": "%config.columns.description%",
          "default": {
            "Author": true,
            "AuthorDate": true,
            "Commit": true,
            "Committer": false,
            "CommitterDate": false,
            "Signature": true
          },
          "properties": {
            "Author": {
              "type": "boolean"
            },
            "AuthorDate": {
              "type": "boolean"
            },
            "Commit": {
              "type": "boolean"
            },
            "Committer": {
              "type": "boolean"
            },
            "CommitterDate": {
              "type": "boolean"
            },
            "Signature": {
              "type": "boolean"
            }
          }
        },
        "git-graph-ray.details.maxHeight": {
          "type": "number",
          "default": 300,
          "minimum": 88,
          "description": "%config.details.maxHeight.description%"
        },
        "git-graph-ray.details.place": {
          "type": "string",
          "enum": [
            "inline",
            "bottom"
          ],
          "default": "inline",
          "description": "%config.details.place.description%"
        },
        "git-graph-ray.details.files": {
          "type": "string",
          "enum": [
            "tree",
            "list"
          ],
          "default": "tree",
          "description": "%config.details.files.description%"
        },
        "git-graph-ray.details.foldSingleFolders": {
          "type": "boolean",
          "default": true,
          "description": "%config.details.foldSingleFolders.description%"
        },
        "git-graph-ray.details.markdown": {
          "type": "boolean",
          "default": true,
          "description": "%config.details.markdown.description%"
        },
        "git-graph-ray.emoji": {
          "type": "array",
          "description": "%config.emoji.description%",
          "items": {
            "type": "object",
            "required": [
              "code",
              "emoji"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "emoji": {
                "type": "string"
              }
            }
          },
          "default": []
        },
        "git-graph-ray.fetch.prune": {
          "type": "boolean",
          "default": false,
          "description": "%config.fetch.prune.description%"
        },
        "git-graph-ray.fetch.pruneTags": {
          "type": "boolean",
          "default": false,
          "description": "%config.fetch.pruneTags.description%"
        },
        "git-graph-ray.fetch.auto": {
          "type": "boolean",
          "default": false,
          "description": "%config.fetch.auto.description%"
        },
        "git-graph-ray.fetch.everySeconds": {
          "type": "number",
          "default": 180,
          "minimum": 15,
          "description": "%config.fetch.everySeconds.description%"
        },
        "git-graph-ray.fetch.tagCacheSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "%config.fetch.tagCacheSeconds.description%"
        },
        "git-graph-ray.files.encoding": {
          "type": "string",
          "default": "utf8",
          "scope": "resource",
          "description": "%config.files.encoding.description%"
        },
        "git-graph-ray.graph.bend": {
          "type": "string",
          "enum": [
            "curve",
            "corner"
          ],
          "default": "curve",
          "description": "%config.graph.bend.description%"
        },
        "git-graph-ray.graph.lanePriority": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "number"
          },
          "markdownDescription": "%config.graph.lanePriority.markdownDescription%"
        },
        "git-graph-ray.graph.palette": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "#3b6cff",
            "#e23b8c",
            "#12a36a",
            "#e07a12",
            "#7a45d6",
            "#d23b3b",
            "#128f9a",
            "#c44ad4",
            "#8aaa14",
            "#b56432",
            "#3a4ad0",
            "#d4a012"
          ],
          "description": "%config.graph.palette.description%"
        },
        "git-graph-ray.graph.theme": {
          "type": "string",
          "enum": [
            "classic",
            "Ray",
            "Ray Wave",
            "Ray Cycle",
            "Ray Stream"
          ],
          "enumDescriptions": [
            "%config.graph.theme.enumDescriptions.classic%",
            "%config.graph.theme.enumDescriptions.Ray%",
            "%config.graph.theme.enumDescriptions.Ray Wave%",
            "%config.graph.theme.enumDescriptions.Ray Cycle%",
            "%config.graph.theme.enumDescriptions.Ray Stream%"
          ],
          "default": "classic"
        },
        "git-graph-ray.graph.background": {
          "type": "string",
          "enum": [
            "auto",
            "dark",
            "light"
          ],
          "enumDescriptions": [
            "%config.graph.background.enumDescriptions.auto%",
            "%config.graph.background.enumDescriptions.dark%",
            "%config.graph.background.enumDescriptions.light%"
          ],
          "default": "dark",
          "description": "%config.graph.background.description%"
        },
        "git-graph-ray.history.pageSize": {
          "type": "number",
          "default": 300,
          "minimum": 1,
          "description": "%config.history.pageSize.description%"
        },
        "git-graph-ray.history.pageMore": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "%config.history.pageMore.description%"
        },
        "git-graph-ray.history.autoPage": {
          "type": "boolean",
          "default": true,
          "description": "%config.history.autoPage.description%"
        },
        "git-graph-ray.history.order": {
          "type": "string",
          "enum": [
            "date",
            "author",
            "topo"
          ],
          "enumDescriptions": [
            "%config.history.order.enumDescriptions.date%",
            "%config.history.order.enumDescriptions.author%",
            "%config.history.order.enumDescriptions.topo%"
          ],
          "default": "date"
        },
        "git-graph-ray.history.muteMerges": {
          "type": "boolean",
          "default": true,
          "description": "%config.history.muteMerges.description%"
        },
        "git-graph-ray.history.dimNotOnHead": {
          "type": "boolean",
          "default": false,
          "description": "%config.history.dimNotOnHead.description%"
        },
        "git-graph-ray.history.remotes": {
          "type": "boolean",
          "default": true,
          "description": "%config.history.remotes.description%"
        },
        "git-graph-ray.history.remoteHeads": {
          "type": "boolean",
          "default": true,
          "description": "%config.history.remoteHeads.description%"
        },
        "git-graph-ray.history.tags": {
          "type": "boolean",
          "default": true,
          "description": "%config.history.tags.description%"
        },
        "git-graph-ray.history.tagOnlyCommits": {
          "type": "boolean",
          "default": true,
          "description": "%config.history.tagOnlyCommits.description%"
        },
        "git-graph-ray.history.stashes": {
          "type": "boolean",
          "default": true,
          "description": "%config.history.stashes.description%"
        },
        "git-graph-ray.history.worktrees": {
          "type": "boolean",
          "default": true,
          "description": "%config.history.worktrees.description%"
        },
        "git-graph-ray.history.uncommitted": {
          "type": "boolean",
          "default": true,
          "description": "%config.history.uncommitted.description%"
        },
        "git-graph-ray.history.untracked": {
          "type": "boolean",
          "default": true,
          "description": "%config.history.untracked.description%"
        },
        "git-graph-ray.history.reflog": {
          "type": "boolean",
          "default": false,
          "description": "%config.history.reflog.description%"
        },
        "git-graph-ray.history.firstParent": {
          "type": "boolean",
          "default": false,
          "description": "%config.history.firstParent.description%"
        },
        "git-graph-ray.history.mailmap": {
          "type": "boolean",
          "default": false,
          "description": "%config.history.mailmap.description%"
        },
        "git-graph-ray.history.avatars": {
          "type": "boolean",
          "default": false,
          "description": "%config.history.avatars.description%"
        },
        "git-graph-ray.history.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "%config.history.autoRefresh.description%"
        },
        "git-graph-ray.history.openCircle": {
          "type": "string",
          "enum": [
            "changes",
            "head"
          ],
          "enumDescriptions": [
            "%config.history.openCircle.enumDescriptions.changes%",
            "%config.history.openCircle.enumDescriptions.head%"
          ],
          "default": "changes"
        },
        "git-graph-ray.keys.find": {
          "type": "string",
          "default": "mod+f",
          "pattern": "^$|^mod\\+[a-z]$",
          "description": "%config.keys.find.description%"
        },
        "git-graph-ray.keys.refresh": {
          "type": "string",
          "default": "mod+r",
          "pattern": "^$|^mod\\+[a-z]$",
          "description": "%config.keys.refresh.description%"
        },
        "git-graph-ray.keys.head": {
          "type": "string",
          "default": "mod+h",
          "pattern": "^$|^mod\\+[a-z]$",
          "description": "%config.keys.head.description%"
        },
        "git-graph-ray.keys.stash": {
          "type": "string",
          "default": "mod+s",
          "pattern": "^$|^mod\\+[a-z]$",
          "description": "%config.keys.stash.description%"
        },
        "git-graph-ray.labels.layout": {
          "type": "string",
          "enum": [
            "together",
            "split"
          ],
          "enumDescriptions": [
            "%config.labels.layout.enumDescriptions.together%",
            "%config.labels.layout.enumDescriptions.split%"
          ],
          "default": "together"
        },
        "git-graph-ray.labels.combine": {
          "type": "boolean",
          "default": true,
          "description": "%config.labels.combine.description%"
        },
        "git-graph-ray.labels.remote": {
          "type": "string",
          "enum": [
            "icon",
            "text"
          ],
          "enumDescriptions": [
            "%config.labels.remote.enumDescriptions.icon%",
            "%config.labels.remote.enumDescriptions.text%"
          ],
          "default": "icon",
          "description": "%config.labels.remote.description%"
        },
        "git-graph-ray.labels.colors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
          },
          "default": {},
          "markdownDescription": "%config.labels.colors.markdownDescription%"
        },
        "git-graph-ray.menus": {
          "type": "object",
          "default": {},
          "markdownDescription": "%config.menus.markdownDescription%"
        },
        "git-graph-ray.pullRequests": {
          "type": "array",
          "description": "%config.pullRequests.description%",
          "items": {
            "type": "object",
            "required": [
              "name",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          },
          "default": []
        },
        "git-graph-ray.rayCat.enabled": {
          "type": "boolean",
          "default": false,
          "description": "%config.rayCat.enabled.description%"
        },
        "git-graph-ray.rayCat.count": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 10,
          "description": "%config.rayCat.count.description%"
        },
        "git-graph-ray.refs.branchSort": {
          "type": "string",
          "enum": [
            "version:refname",
            "-version:refname",
            "refname",
            "-refname"
          ],
          "default": "version:refname",
          "description": "%config.refs.branchSort.description%"
        },
        "git-graph-ray.refs.tagSort": {
          "type": "string",
          "enum": [
            "version:refname",
            "-version:refname",
            "refname",
            "-refname"
          ],
          "default": "-version:refname",
          "description": "%config.refs.tagSort.description%"
        },
        "git-graph-ray.refs.listLimit": {
          "type": "number",
          "default": 200,
          "minimum": 1,
          "description": "%config.refs.listLimit.description%"
        },
        "git-graph-ray.sign.commits": {
          "type": "boolean",
          "default": false,
          "description": "%config.sign.commits.description%"
        },
        "git-graph-ray.sign.tags": {
          "type": "boolean",
          "default": false,
          "description": "%config.sign.tags.description%"
        },
        "git-graph-ray.startup.searchDepth": {
          "type": "number",
          "default": 0,
          "description": "%config.startup.searchDepth.description%"
        },
        "git-graph-ray.startup.repoOfActiveFile": {
          "type": "boolean",
          "default": false,
          "description": "%config.startup.repoOfActiveFile.description%"
        },
        "git-graph-ray.startup.editorColumn": {
          "type": "string",
          "enum": [
            "active",
            "beside",
            "1",
            "2",
            "3",
            "4",
            "5",
            "6",
            "7",
            "8",
            "9"
          ],
          "default": "active",
          "description": "%config.startup.editorColumn.description%"
        },
        "git-graph-ray.startup.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "%config.startup.statusBar.description%"
        },
        "git-graph-ray.startup.scmButton": {
          "type": "string",
          "enum": [
            "bar",
            "menu"
          ],
          "enumDescriptions": [
            "%config.startup.scmButton.enumDescriptions.bar%",
            "%config.startup.scmButton.enumDescriptions.menu%"
          ],
          "default": "bar"
        },
        "git-graph-ray.startup.keepWebview": {
          "type": "boolean",
          "default": true,
          "description": "%config.startup.keepWebview.description%"
        },
        "git-graph-ray.startup.scrollToHead": {
          "type": "boolean",
          "default": false,
          "description": "%config.startup.scrollToHead.description%"
        },
        "git-graph-ray.startup.onlyCheckedOut": {
          "type": "boolean",
          "default": false,
          "description": "%config.startup.onlyCheckedOut.description%"
        },
        "git-graph-ray.startup.branches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.startup.branches.description%"
        },
        "git-graph-ray.startup.repoOrder": {
          "type": "string",
          "enum": [
            "workspace",
            "name",
            "path"
          ],
          "enumDescriptions": [
            "%config.startup.repoOrder.enumDescriptions.workspace%",
            "%config.startup.repoOrder.enumDescriptions.name%",
            "%config.startup.repoOrder.enumDescriptions.path%"
          ],
          "default": "workspace",
          "description": "%config.startup.repoOrder.description%"
        },
        "git-graph-ray.terminal.shell": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.terminal.shell.description%"
        },
        "git-graph-ray.undo.preview": {
          "type": "boolean",
          "default": true,
          "description": "%config.undo.preview.description%"
        },
        "git-graph-ray.when.format": {
          "type": "string",
          "enum": [
            "datetime",
            "date",
            "iso",
            "isoDate",
            "relative"
          ],
          "enumDescriptions": [
            "%config.when.format.enumDescriptions.datetime%",
            "%config.when.format.enumDescriptions.date%",
            "%config.when.format.enumDescriptions.iso%",
            "%config.when.format.enumDescriptions.isoDate%",
            "%config.when.format.enumDescriptions.relative%"
          ],
          "default": "datetime",
          "description": "%config.when.format.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "npm run compile:host && npm run compile:webview",
    "compile:host": "vite build --config vite.config.host.mts",
    "compile:webview": "vite build --config vite.config.webview.mts",
    "watch": "concurrently -n host,webview -c blue,magenta \"vite build --config vite.config.host.mts --watch\" \"vite build --config vite.config.webview.mts --watch\"",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.webview.json",
    "vsce:package": "npm run compile && npx @vscode/vsce package -o ./dist/"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "~1.120.0",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@vscode/l10n": "^0.0.18"
  }
}
