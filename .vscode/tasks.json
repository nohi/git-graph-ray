{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "watch",
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "build started",
          "endsPattern": "built in"
        }
      }
    },
    {
      "label": "compile",
      "type": "npm",
      "script": "compile"
    },
    {
      "label": "debug",
      "type": "shell",
      "command": "code --wait --new-window --extensionDevelopmentPath=${workspaceFolder} --disable-extensions --disable-workspace-trust --user-data-dir=${workspaceFolder}/debug/user-data ${workspaceFolder}",
      "dependsOn": ["compile"],
      "presentation": {
        "reveal": "silent"
      },
      "problemMatcher": []
    }
  ]
}
